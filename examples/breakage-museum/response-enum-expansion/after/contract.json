{
  "openapi": "3.1.0",
  "info": { "title": "Synthetic Widget API", "version": "1.1.0" },
  "paths": {
    "/v1/widgets": {
      "get": {
        "operationId": "listWidgets",
        "responses": {
          "200": {
            "description": "Widgets",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Widget" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["active", "archived", "draft"]
          }
        }
      }
    }
  }
}
