{
  "openapi": "3.1.0",
  "info": { "title": "Synthetic Widget API", "version": "1.1.0" },
  "paths": {
    "/v1/widgets/{id}": {
      "get": {
        "operationId": "getWidget",
        "responses": {
          "200": {
            "description": "Widget",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Widget" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Widget": {
        "type": "object",
        "properties": {
          "id": { "type": "string" }
        },
        "required": ["id"]
      }
    }
  }
}
